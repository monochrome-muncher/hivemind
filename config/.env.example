# Hivemind configuration — master template for the per-environment
# profile files (ADR 0017). Copy it to the profile you need:
#
#   cp config/.env.example .env.local      # the fallback profile (ENVIRONMENT unset)
#   cp config/.env.example .env.staging    # ENVIRONMENT=staging
#   cp config/.env.example .env.production # ENVIRONMENT=production
#   cp config/.env.example .env.test       # ENVIRONMENT=test
#
# ENVIRONMENT selects the file `load_settings` reads (ADR 0017):
# production / staging / test → .env.<name>, anything else or unset →
# .env.local. Real HIVEMIND_* env vars ALWAYS win over file values; a
# missing file is ignored (Kubernetes / CI use env / Secrets).
#
# Every key maps to a `Settings` field in src/hivemind/config.py, except
# HIVEMIND_HOST/PORT/MCP_KEY/MCP_HTTP_PORT (and HIVEMIND_RUNNER), which
# are exempt by design (`_ALLOWED_EXTRA_ENV_VARS`). Any other HIVEMIND_*
# variable is logged as a WARNING with a "did you mean" (ADRs 0024,
# 0032). Values below are safe defaults; override per deployment.
#
# ── Logging ────────────────────────────────────────────────────────────
# DEBUG/INFO/WARNING/ERROR/CRITICAL, case-insensitive.
HIVEMIND_LOG_LEVEL=INFO
# true = unknown HIVEMIND_* variables fail startup instead of warning
# (for dev / CI, where no platform injects its own). ADR 0032.
HIVEMIND_STRICT_ENV=false

# ── Database (single Postgres pool, pgvector) ─────────────────────────
# Needs pgvector >= 0.8 available (`hivemind-migrate` creates the
# extension) and HIVEMIND_EMBEDDING_DIM <= 2000 (HNSW limit); migrate
# fails with an actionable message otherwise.
HIVEMIND_DATABASE_URL=postgresql://hivemind:hivemind@localhost:5432/hivemind
# Optional direct (non-pooled) DSN used only by hivemind-migrate; set it
# when HIVEMIND_DATABASE_URL goes through a transaction-mode PgBouncer,
# which cannot hold the migration's advisory lock. Empty = migrate
# through HIVEMIND_DATABASE_URL.
# HIVEMIND_MIGRATE_DATABASE_URL=
# Connections per pod for each app pool (store and authenticator each
# have one): size against Postgres max_connections × replicas.
# Timeouts are seconds (statement: ms) and never apply to migrate; 0
# disables a bound. STATEMENT_TIMEOUT_MS is a server-side startup
# parameter that a transaction-mode PgBouncer rejects: leave it 0 unless
# the pool connects to Postgres directly.
HIVEMIND_POOL_MIN_SIZE=1
HIVEMIND_POOL_MAX_SIZE=10
HIVEMIND_POOL_COMMAND_TIMEOUT=30.0
HIVEMIND_POOL_STATEMENT_TIMEOUT_MS=0
HIVEMIND_POOL_ACQUIRE_TIMEOUT=10.0
HIVEMIND_POOL_CONNECT_TIMEOUT=10.0

# ── Embeddings (ADR 0005: deploy-time, OpenAI-compatible) ────────────
# Base URL of an OpenAI-compatible embeddings endpoint (OpenAI, or a
# self-hosted vLLM/Ollama if data must not leave the org).
HIVEMIND_EMBEDDING_ENDPOINT=http://localhost:8001/v1
# Bearer token (empty for self-hosted endpoints that don't require auth).
HIVEMIND_EMBEDDING_API_KEY=
# Recorded per entry. The repo's local vLLM (`make vllm`) serves this
# model; for OpenAI use e.g. text-embedding-3-small with its own
# endpoint, key and dim.
HIVEMIND_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Must match what the endpoint returns (ADR 0005/0015). Code default
# 1024; the dev Makefile pins 512, so set 512 to use a pool it migrated.
# A mismatch with an existing pool fails at migrate time.
HIVEMIND_EMBEDDING_DIM=1024
# Body prefix embedded (SPEC §7), in whitespace-delimited words, NOT
# tokenizer tokens (ADR 0021). The extractor reads the same text.
HIVEMIND_EMBEDDING_PREFIX_TOKENS=2000
# Retries on transient failures (timeouts/429/5xx), ADR 0014; 0
# disables. Embeddings are NOT best-effort: exhausting it fails the write.
HIVEMIND_EMBEDDING_RETRIES=2
# Per-attempt timeout (seconds). Feeds the k8s
# terminationGracePeriodSeconds arithmetic (DEPLOY.md §5): raise both.
HIVEMIND_EMBEDDING_TIMEOUT=10.0
# Wall-clock budget (seconds) for one embed call, retries and backoff
# included (ADR 0041). Unset = derived worst case. Must be >= the timeout.
# HIVEMIND_EMBEDDING_DEADLINE=

# ── Entity extraction (ADR 0016, SPEC §13: optional + best-effort) ───
# An OpenAI-compatible *chat* endpoint. EMPTY ENDPOINT = EXTRACTION OFF
# (empty `entities`, no LLM cost). A failure never blocks a write.
HIVEMIND_EXTRACTOR_ENDPOINT=
HIVEMIND_EXTRACTOR_API_KEY=
HIVEMIND_EXTRACTOR_MODEL=
# Per-call timeout (seconds) and the transient-failure retry budget.
HIVEMIND_EXTRACTOR_TIMEOUT=30.0
# Overall budget (seconds) for one extraction, retries included; leave
# unset to derive it (ADR 0041).
# HIVEMIND_EXTRACTOR_DEADLINE=
HIVEMIND_EXTRACTOR_RETRIES=2

# ── Retrieval knobs (ADR 0006, SPEC §6.2/§6.4 — tune, don't hardcode) ─
# Reciprocal-rank-fusion constant (60 is the standard default).
HIVEMIND_RRF_K=60
# Keyword vs. vector fusion weights (sum ~1.0).
HIVEMIND_WEIGHT_KEYWORD=0.5
HIVEMIND_WEIGHT_VECTOR=0.5
# Candidate pool size before RRF fusion + decay rescore.
HIVEMIND_CANDIDATE_TOP_K=20
# Default result cap for search/list.
HIVEMIND_DEFAULT_LIMIT=10
# Recency half-life (days) for the decay-aware rescore.
HIVEMIND_HALF_LIFE_DAYS=30.0
# Lower bound on the recency factor max(floor, 0.5 ** (age/half_life))
# (ADR 0022, SPEC §6.4), keeping match quality the sort key. A band, not
# a slider: toward 1.0 deletes the term (0.9 measures WORSE), below
# 0.381 it does nothing. Range (0, 1]; keep 0.8 unless re-measured on
# your own corpus. Empty or "none" = no floor (ADR 0023).
HIVEMIND_RECENCY_FLOOR=0.8
# Similarity threshold for the vector stream (ADR 0062): an entry reaches
# search through it only when its cosine similarity to the query is above
# this, so a search with nothing relevant can come back empty. It depends
# on the embedding model: measure a value with `make measure-threshold`
# before setting it (docs/retrieval-experiments.md). Range [0, 1); empty
# or "none" = off (today's behaviour: any positive similarity).
HIVEMIND_VECTOR_MIN_SIMILARITY=
# Feedback quality-formula weights (SPEC §6.4). A "helpful" vote nudges
# quality up; "stale"/"wrong" pull it down; clamped to [min, max].
HIVEMIND_QUALITY_HELPFUL_WEIGHT=0.05
HIVEMIND_QUALITY_STALE_WEIGHT=0.10
HIVEMIND_QUALITY_WRONG_WEIGHT=0.25
HIVEMIND_QUALITY_MIN=0.5
HIVEMIND_QUALITY_MAX=1.2

# ── HTTP / runner surface (consumed by the console entrypoints) ───────
# Host + port the REST / streamable-HTTP MCP runners bind to.
HIVEMIND_HOST=127.0.0.1
HIVEMIND_PORT=8000
# MCP-HTTP DNS-rebinding guard (ADR 0042). Unset = SDK default (checked
# only on a loopback bind, so an ingress in front of 0.0.0.0 works). Set
# the public Host value(s) (`name` or `name:*`) to enforce; ORIGINS
# (browser clients) needs HOSTS.
# HIVEMIND_MCP_ALLOWED_HOSTS=hivemind.example.com
# HIVEMIND_MCP_ALLOWED_ORIGINS=
# Per-agent key for the stdio `hivemind-mcp-pg` runner (ADR 0009); each
# agent's MCP config normally sets its own.
HIVEMIND_MCP_KEY=
# Host port for the `make mcp-http` docker service (default 8088).
HIVEMIND_MCP_HTTP_PORT=8088
# ── Admin panel (`hivemind-admin`, ADR 0029) ──────────────────────────
# Base URL of the hivemind-api it proxies to; required by that runner,
# ignored by others. It binds HIVEMIND_HOST/PORT (default port 8080).
HIVEMIND_ADMIN_API_URL=
# PEM bundle to verify an https HIVEMIND_ADMIN_API_URL against (an
# internal CA). Empty = the system trust store.
HIVEMIND_ADMIN_API_CA_BUNDLE=
