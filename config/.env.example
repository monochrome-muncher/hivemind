# Hivemind configuration — master template for the per-environment
# profile files (ADR 0017). Copy it to the profile you need:
#
#   cp config/.env.example .env.local      # the fallback profile (ENVIRONMENT unset)
#   cp config/.env.example .env.staging    # ENVIRONMENT=staging
#   cp config/.env.example .env.production # ENVIRONMENT=production
#   cp config/.env.example .env.test       # ENVIRONMENT=test
#
# The ENVIRONMENT env var selects which file `load_settings` reads
# (src/hivemind/config.py, ADR 0017): production → .env.production,
# staging → .env.staging, test → .env.test, anything else / unset →
# .env.local. Real HIVEMIND_* environment variables ALWAYS win over
# file values; a missing file is silently ignored (Kubernetes / CI:
# values come from env / Secrets and no profile file is present).
#
# Every key here maps 1:1 to a field in `src/hivemind/config.py`
# (Settings, HIVEMIND_* env vars), EXCEPT the five under "HTTP / runner
# surface" below (HIVEMIND_RUNNER/HOST/PORT/MCP_KEY/MCP_HTTP_PORT), which
# are deliberately NOT Settings fields — see `_ALLOWED_EXTRA_ENV_VARS` in
# config.py for why each one is exempt. Any OTHER HIVEMIND_* variable is
# rejected at startup by `load_settings()` (ADR 0024): a name that is
# neither a Settings field nor on that exemption list is a typo or a
# stale variable, not a third category, so it fails loudly instead of
# being silently ignored. Values below are safe defaults — override per
# deployment.
#
# ── Database (ADR 0011/0012: single Postgres pool, pgvector) ──────────
# The Postgres DSN. Must point at a pool with the `vector` (pgvector)
# extension available (it is applied by `hivemind-migrate`).
HIVEMIND_DATABASE_URL=postgresql://hivemind:hivemind@localhost:5432/hivemind

# ── Embeddings (ADR 0005: deploy-time, OpenAI-compatible) ────────────
# Base URL of an OpenAI-compatible embeddings endpoint (OpenAI, or a
# self-hosted vLLM/Ollama if data must not leave the org).
HIVEMIND_EMBEDDING_ENDPOINT=http://localhost:8001/v1
# Bearer token (empty for self-hosted endpoints that don't require auth).
HIVEMIND_EMBEDDING_API_KEY=
# The model name (recorded per entry for provenance).
HIVEMIND_EMBEDDING_MODEL=text-embedding-3-small
# The vector dimension. A deploy-time decision (ADR 0005/0015): must
# match the dimension the endpoint actually returns. Code default is
# 1024; the dev Makefile pins 512 for a fast local vLLM model. A
# mismatch against an existing pool fails loudly at migrate time
# (ADR 0015) — never a silent no-op.
HIVEMIND_EMBEDDING_DIM=1024
# How much of the body prefix is embedded (SPEC §7), counted in
# whitespace-delimited words — NOT a model tokenizer's tokens (ADR 0021).
# The extractor reads the same bounded text (ADR 0016).
HIVEMIND_EMBEDDING_PREFIX_TOKENS=2000
# Bounded retries on transient embedder failures (timeouts/429/5xx),
# ADR 0014. 0 disables. A still-failing embedder after the budget
# fails the write (embeddings are NOT best-effort).
HIVEMIND_EMBEDDING_RETRIES=2

# ── Entity extraction (ADR 0016, SPEC §13: optional + best-effort) ───
# An OpenAI-compatible *chat* endpoint, usually a different model than
# the embeddings one. LEAVE ENDPOINT EMPTY TO TURN EXTRACTION OFF
# (entries land with empty `entities`, zero LLM-extraction cost).
# Extraction is best-effort: a failure never blocks a write.
HIVEMIND_EXTRACTOR_ENDPOINT=
HIVEMIND_EXTRACTOR_API_KEY=
HIVEMIND_EXTRACTOR_MODEL=
# Per-call timeout (seconds) and the transient-failure retry budget.
HIVEMIND_EXTRACTOR_TIMEOUT=30.0
HIVEMIND_EXTRACTOR_RETRIES=2

# ── Retrieval knobs (ADR 0006, SPEC §6.2/§6.4 — tune, don't hardcode) ─
# Reciprocal-rank-fusion constant (60 is the standard default).
HIVEMIND_RRF_K=60
# Keyword vs. vector fusion weights (sum ~1.0).
HIVEMIND_WEIGHT_KEYWORD=0.5
HIVEMIND_WEIGHT_VECTOR=0.5
# Candidate pool size before RRF fusion + decay rescore.
HIVEMIND_CANDIDATE_TOP_K=20
# Default result cap for search/list.
HIVEMIND_DEFAULT_LIMIT=10
# Recency half-life (days) for the decay-aware rescore.
HIVEMIND_HALF_LIFE_DAYS=30.0
# Lower bound on the recency factor (ADR 0022, SPEC §6.4): the factor is
# max(floor, 0.5 ** (age/half_life)), so its whole range is 1/floor. 0.8
# = 1.25x, inside RRF's 2.62x fused range, which keeps match quality the
# sort key and recency the tie-break. **A band, not a slider** — raising
# it toward 1.0 deletes the recency term (0.9 measures WORSE than 1.0),
# and below 0.381 it does nothing. Valid range here: (0, 1]. Leave it at
# 0.8 unless you have re-measured on your own aged corpus (ADR 0022's
# trigger). To revert to the pre-ADR-0022 unbounded behaviour ("no
# floor"), set this to an empty value or to "none" (ADR 0023) — not a
# negligible number.
HIVEMIND_RECENCY_FLOOR=0.8
# Feedback quality-formula weights (SPEC §6.4). A "helpful" vote nudges
# quality up; "stale"/"wrong" pull it down; clamped to [min, max].
HIVEMIND_QUALITY_HELPFUL_WEIGHT=0.05
HIVEMIND_QUALITY_STALE_WEIGHT=0.10
HIVEMIND_QUALITY_WRONG_WEIGHT=0.25
HIVEMIND_QUALITY_MIN=0.5
HIVEMIND_QUALITY_MAX=1.2

# ── HTTP / runner surface (consumed by the console entrypoints) ───────
# Host + port the REST / streamable-HTTP MCP runners bind to.
HIVEMIND_HOST=127.0.0.1
HIVEMIND_PORT=8000
# Per-agent credential for the Postgres-backed stdio MCP runner (ADR
# 0009). Leave empty unless overriding; an agent's MCP config sets its
# own key. (The hostable mcp-http runner authenticates per-request from
# the Postgres `credentials` table instead, ADR 0010.)
HIVEMIND_MCP_KEY=
# Host port mapping for the `make mcp-http` docker service (default 8088).
HIVEMIND_MCP_HTTP_PORT=8088