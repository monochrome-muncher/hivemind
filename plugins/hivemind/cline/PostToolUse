#!/bin/sh
# Hivemind Cline hook: PostToolUse — the end-of-task write-and-rate nudge.
#
# Cline fires PostToolUse after every tool call, with the payload JSON on
# stdin (taskId at the top level, postToolUse.toolName the tool; the older
# tool_name spelling is still read). This counts the task's tool calls in a
# temp file (reset by the TaskStart hook) and, once a task has made
# HIVEMIND_STOP_MIN_TOOLS (default 20) calls without calling hive_feedback
# and either without hive_write or after reading entries (hive_search,
# hive_get), steers the agent once, via contextModification, to write what
# another agent could reuse and rate what it tested; if nothing is new it
# just finishes.
#
# Subagent tasks are never counted and never reminded (a non-empty string in
# parent_agent_id, which the CLI hook runner sends at the top level, or in
# parentAgentId, which the other runner sends in sessionContext, marks one;
# a JSON null is not a string and so does not). The nudge stays silent in
# incognito sessions and while HIVEMIND_API_KEY is unset, when the tools
# cannot work. Static and offline; it never prints the key.

# Extract "name": "value" from the payload, tolerating whitespace after
# the colon (Cline's serializer and tests format it differently).
field() {
  printf '%s' "$payload" \
    | grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 \
    | sed "s/^\"$1\"[[:space:]]*:[[:space:]]*\"//; s/\"$//"
}

payload=$(cat 2>/dev/null)
task_id=$(field taskId)
parent=$(field parent_agent_id)
[ -n "$parent" ] || parent=$(field parentAgentId)
tool_name=$(field toolName)
[ -n "$tool_name" ] || tool_name=$(field tool_name)

# A subagent reports to its parent; leave it alone, as in Claude Code.
if [ -n "$parent" ]; then
  printf '{"cancel":false}\n'
  exit 0
fi

safe=$(printf '%s' "$task_id" | tr -c 'a-zA-Z0-9' '_')

# The counter lives in a private per-user folder, as in
# skills/hivemind-setup/scripts/hivemind-stop.sh: a predictable path in
# shared /tmp let another local user pre-create it as a symlink (so our
# write truncated a file they owned) or plant counter values to suppress
# or force the nudge. A folder that is not a real directory of ours, or is
# group/other writable, is refused: the hook fails open, counting nothing.
bail() { printf '{"cancel":false}\n'; exit 0; }
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] \
  && [ ! -L "$XDG_RUNTIME_DIR" ] && [ -O "$XDG_RUNTIME_DIR" ]; then
  state_dir="$XDG_RUNTIME_DIR/hivemind-cline"
else
  uid=$(id -u 2>/dev/null) && [ -n "$uid" ] || bail
  state_dir="${TMPDIR:-/tmp}/hivemind-cline-$uid"
fi
[ -e "$state_dir" ] || [ -L "$state_dir" ] || mkdir -m 700 "$state_dir" 2>/dev/null
[ -d "$state_dir" ] && [ ! -L "$state_dir" ] && [ -O "$state_dir" ] || bail
case "$(ls -ld "$state_dir" 2>/dev/null)" in d????w*|d???????w*) bail ;; esac
state="$state_dir/${safe:-none}"
write_state() { (umask 077; printf '%s %s %s %s %s\n' "$calls" "$contributed" "$reminded" "$rated" "$seen" > "$state") 2>/dev/null; }

calls=0
contributed=0
reminded=0
rated=0
seen=0
if [ -f "$state" ]; then
  read -r calls contributed reminded rated seen < "$state" 2>/dev/null
fi
case "$calls" in ''|*[!0-9]*) calls=0 ;; esac
case "$contributed" in ''|*[!0-9]*) contributed=0 ;; esac
case "$reminded" in ''|*[!0-9]*) reminded=0 ;; esac
case "$rated" in ''|*[!0-9]*) rated=0 ;; esac
case "$seen" in ''|*[!0-9]*) seen=0 ;; esac

case "${tool_name:-}" in
  *hive_write) contributed=1 ;;
  *hive_feedback) contributed=1; rated=1 ;;
  *hive_search|*hive_get) seen=1 ;;
esac
calls=$((calls + 1))

threshold="${HIVEMIND_STOP_MIN_TOOLS:-20}"
case "$threshold" in ''|*[!0-9]*) threshold=20 ;; esac

if [ "$calls" -ge "$threshold" ] && [ "$reminded" -eq 0 ] \
  && [ "$rated" -eq 0 ] && { [ "$contributed" -eq 0 ] || [ "$seen" -eq 1 ]; }; then
  incognito=$(printf '%s' "${HIVEMIND_INCOGNITO:-}" | tr '[:upper:]' '[:lower:]')
  case "$incognito" in
    1|true|yes|on) incognito=1 ;;
    *) incognito="" ;;
  esac
  if [ -n "$incognito" ] || [ -z "${HIVEMIND_API_KEY:-}" ]; then
    # Still record the count so a later key change does not fire it.
    write_state
    printf '{"cancel":false}\n'
    exit 0
  fi
  reminded=1
  write_state
  printf '{"cancel":false,"contextModification":"HIVEMIND: before finishing, write to Hivemind (hive_write) what another agent could reuse from this task, and rate the entries your work tested (hive_feedback). If nothing is new, write nothing and just finish.","errorMessage":""}\n'
  exit 0
fi

write_state
printf '{"cancel":false}\n'
