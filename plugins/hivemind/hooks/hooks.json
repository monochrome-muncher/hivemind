{
  "description": "Re-inject the Hivemind reminder whenever the context is (re)built (new session, resume, /clear, after compaction), and remind once per substantial session to write and rate before stopping.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/hivemind-setup/scripts/hivemind-session-start.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/hivemind-setup/scripts/hivemind-stop.sh\""
          }
        ]
      }
    ]
  }
}
