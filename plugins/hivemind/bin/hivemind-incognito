#!/bin/sh
# hivemind-incognito — start an agent harness in an incognito session
# (ADR 0035): Hivemind is completely off, and nothing is read or written.
#
#   hivemind-incognito <harness> [harness arguments...]
#   e.g.  hivemind-incognito claude
#         hivemind-incognito codex "fix the flaky test"
#
# Two layers, both client-side (the server never learns about the session):
#   1. HIVEMIND_INCOGNITO=1 in the environment. The plugin's reminders
#      (SessionStart hook, Hermes and Pi system-prompt sections) switch to
#      the incognito text, and the DeepSeek Harness bundle skips the server.
#   2. The harness's own switch that keeps the Hivemind MCP server from
#      loading, so the tools are not even there. Where a harness has no
#      such switch configured, this prints a note and the session relies on
#      the agent honouring layer 1 ("by restraint").
#
# Where the server is kept from loading (claude, codex, dsh, pi, omp) the
# launcher also removes HIVEMIND_API_KEY and HIVEMIND_MCP_URL from the
# child's environment, so an agent with a shell cannot read the key or call
# the REST API with it. Where the session is incognito by restraint only
# (hermes, opencode, other launchers) the variables are left in place: the
# harness may still need them, and the README says so.
set -eu

if [ "$#" -lt 1 ]; then
  echo "usage: hivemind-incognito <claude|codex|dsh|hermes|pi|omp|opencode|other-command> [args...]" >&2
  exit 2
fi
harness=$1
shift
export HIVEMIND_INCOGNITO=1
note() { echo "hivemind-incognito: $*" >&2; }
# JSON-escape a string for embedding between double quotes.
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
home_dir=${HOME:-}

case "$(basename "$harness")" in
  claude)
    # Deny the server for this session only (--settings outranks user
    # settings; the denylist also covers servers a plugin adds). A plugin's
    # MCP server registers as "plugin:<plugin>:<server>" (Claude Code MCP
    # docs), i.e. "plugin:hivemind:hivemind"; a hand-added one as
    # "hivemind". Whether a serverName entry matches the scoped form is
    # UNCONFIRMED in the docs, so both names and the URL are denied. The URL
    # comes from the launching shell, else from the "env" block of
    # ~/.claude/settings.json (where the setup skill may have put it).
    url=${HIVEMIND_MCP_URL:-}
    if [ -z "$url" ] && [ -n "$home_dir" ] && [ -f "$home_dir/.claude/settings.json" ] \
      && command -v python3 >/dev/null 2>&1; then
      url=$(python3 - "$home_dir/.claude/settings.json" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1]) as fh:
        print(json.load(fh).get("env", {}).get("HIVEMIND_MCP_URL", "") or "")
except (OSError, ValueError, AttributeError):
    pass
PY
)
    fi
    denied='{"serverName":"hivemind"},{"serverName":"plugin:hivemind:hivemind"}'
    if [ -n "$url" ]; then
      denied="$denied,{\"serverUrl\":\"$(json_escape "$url")\"}"
    else
      note "HIVEMIND_MCP_URL is not set in this shell or in ~/.claude/settings.json; denying the server by name only"
    fi
    # The server is denied, so the session needs neither value. (A key set
    # in ~/.claude/settings.json "env" is applied by Claude Code itself and
    # stays visible to the session's shell.)
    unset HIVEMIND_API_KEY HIVEMIND_MCP_URL
    exec "$harness" --settings "{\"deniedMcpServers\":[$denied]}" "$@"
    ;;
  codex)
    # -c on a server that is not configured creates an invalid entry, so
    # only add it when a config.toml defines mcp_servers.hivemind: the user
    # one, or the project's .codex/config.toml. Both the table form and
    # dotted keys count; spaces inside the brackets are allowed.
    found=0
    codex_home=${CODEX_HOME:-}
    if [ -z "$codex_home" ] && [ -n "$home_dir" ]; then codex_home="$home_dir/.codex"; fi
    for config in "${codex_home:+$codex_home/config.toml}" ".codex/config.toml"; do
      [ -n "$config" ] && [ -f "$config" ] || continue
      if grep -Eq '^[[:space:]]*(\[[[:space:]]*mcp_servers\.hivemind[[:space:]]*\]|mcp_servers\.hivemind[[:space:].=])' "$config"; then
        found=1
      fi
    done
    if [ "$found" = 1 ]; then
      unset HIVEMIND_API_KEY
      exec "$harness" -c 'mcp_servers.hivemind.enabled=false' "$@"
    fi
    note "no mcp_servers.hivemind in ~/.codex/config.toml or .codex/config.toml; starting without an override"
    exec "$harness" "$@"
    ;;
  dsh)
    # The hivemind bundle disables its own server row when
    # HIVEMIND_INCOGNITO is set (from the environment or ~/.dsh/.env, never
    # turned off by a project .env); the key is not needed either.
    unset HIVEMIND_API_KEY HIVEMIND_MCP_URL
    exec "$harness" "$@"
    ;;
  hermes)
    # Hermes interpolates ${VAR} into the server config before reading
    # `enabled`, so a config with `enabled: ${HIVEMIND_ENABLED}` is off here.
    export HIVEMIND_ENABLED=false
    config="${HERMES_HOME:-${home_dir:-.}/.hermes}/config.yaml"
    if ! grep -q 'HIVEMIND_ENABLED' "$config" 2>/dev/null; then
      note "$config does not gate the hivemind server on \${HIVEMIND_ENABLED}; the tools may still load (see the plugin README, Incognito sessions)"
    fi
    exec "$harness" "$@"
    ;;
  omp)
    # Oh My Pi has no per-session MCP switch, and its mcp.json resolves
    # ${HIVEMIND_MCP_URL}/${HIVEMIND_API_KEY} at startup: without them the
    # server is never contacted (OMP warns once that it is unavailable).
    # The hivemind extension also blocks any Hivemind call it sees.
    unset HIVEMIND_MCP_URL HIVEMIND_API_KEY
    exec "$harness" "$@"
    ;;
  opencode)
    # The hivemind OpenCode plugin skips the server when HIVEMIND_INCOGNITO
    # is set. A server added by hand in opencode.json is disabled for this
    # run through OpenCode's highest-precedence config overlay.
    if [ -z "${OPENCODE_CONFIG_CONTENT:-}" ]; then
      export OPENCODE_CONFIG_CONTENT='{"mcp":{"hivemind":{"enabled":false}}}'
    fi
    exec "$harness" "$@"
    ;;
  pi)
    # pi-mcp-adapter loads exactly one MCP config in exclusive mode: build
    # one from the global and project configs, minus the hivemind server.
    # The merged file can hold other servers' literal tokens, so it is
    # private and removed when Pi exits (no exec, so the trap can run).
    # mktemp creates the file 0600 by itself (no umask change, which would
    # leak into the harness). The directory is the first writable one of
    # $XDG_RUNTIME_DIR, $TMPDIR, /tmp: a stale XDG_RUNTIME_DIR must not stop
    # Pi from starting.
    merged=
    if command -v python3 >/dev/null 2>&1; then
      for d in "${XDG_RUNTIME_DIR:-}" "${TMPDIR:-}" /tmp; do
        if [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ]; then
          merged=$(mktemp "$d/hivemind-incognito-mcp.XXXXXX" 2>/dev/null) || merged=
          [ -n "$merged" ] && break
        fi
      done
    fi
    if [ -n "$merged" ]; then
      if [ -z "$home_dir" ]; then
        note "HOME is not set; the global ~/.config/mcp/mcp.json is skipped (only the project .mcp.json is kept)"
      fi
      trap 'rm -f "$merged"' EXIT
      trap 'exit 130' INT
      trap 'exit 143' TERM HUP
      python3 - "$merged" "$home_dir" <<'PY'
import json, os, sys
servers = {}
home = sys.argv[2]
paths = [".mcp.json"]
if home:
    paths.insert(0, os.path.join(home, ".config", "mcp", "mcp.json"))
for path in paths:
    try:
        with open(path) as fh:
            servers.update(json.load(fh).get("mcpServers", {}))
    except (OSError, ValueError):
        pass
servers.pop("hivemind", None)
with open(sys.argv[1], "w") as fh:
    json.dump({"mcpServers": servers}, fh)
PY
      export PI_MCP_CONFIG_MODE=exclusive
      unset HIVEMIND_API_KEY HIVEMIND_MCP_URL
      rc=0
      "$harness" --mcp-config "$merged" "$@" || rc=$?
      exit "$rc"
    fi
    note "python3 or a writable temp directory not found; starting without removing the hivemind server"
    exec "$harness" "$@"
    ;;
  *)
    note "no built-in switch for '$harness'; HIVEMIND_INCOGNITO=1 is set, so the agent is told not to use Hivemind (incognito by restraint: the key and URL stay in its environment)"
    exec "$harness" "$@"
    ;;
esac
