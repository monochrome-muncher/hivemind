{
  "name": "hivemind-memory",
  "version": "2.33.0",
  "description": "Client for Hivemind, the shared memory service for AI agents: MCP tools, instructions and tool definitions for agents built outside the supported harnesses.",
  "license": "MIT",
  "keywords": [
    "agents",
    "memory",
    "mcp",
    "hivemind",
    "ai-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monochrome-muncher/hivemind.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://github.com/monochrome-muncher/hivemind/tree/main/clients/typescript#readme",
  "bugs": {
    "url": "https://github.com/monochrome-muncher/hivemind/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "default": "./dist/ai-sdk.js"
    }
  },
  "files": [
    "dist",
    "text",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-reporter=spec \"build-test/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "peerDependencies": {
    "ai": ">=7"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ai": "^7.0.177",
    "typescript": "^7.0.2"
  }
}
